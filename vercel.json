{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...route].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...route]"
    },
    {
      "source": "/health",
      "destination": "/api/[...route]"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-scan",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/daily-scan",
      "schedule": "0 16 * * *"
    }
  ]
}
